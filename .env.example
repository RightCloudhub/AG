# AgenticGraphRAG configuration reference. Copy this file to .env and edit it.
# ./scripts/setup.sh generates .env from this file when none exists; `python scripts/doctor.py`
# then reports what is missing. Nothing below must be filled in for the offline path.
# Settings-backed values below are read automatically from .env in the working
# directory. Process-only switches must be exported before starting API/CLI/worker:
#   set -a
#   . ./.env
#   set +a
#   agr-api
# Use 0/1 for switches. Commented assignments are optional; unset keeps defaults.
# Process environment takes precedence over .env; supported overrides beat YAML.

# LLM chat / completion (OpenAI-compatible; Settings-backed)
# Leave the key empty for offline development. Live API LLM calls require a
# non-placeholder key and the exported AGR_ALLOW_LLM switch set to 1.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_STRONG_MODEL=gpt-4.1
LLM_LIGHT_MODEL=gpt-4.1-mini

# Embeddings (Settings-backed)
# Unset base URL/key use llm.embedding_* in YAML, then the chat URL/key.
# The model overrides llm.embedding_model.
LLM_EMBEDDING_MODEL=text-embedding-3-small
# LLM_EMBEDDING_BASE_URL=https://api.openai.com/v1
# LLM_EMBEDDING_API_KEY=replace-with-embedding-key

# Neo4j (Settings-backed; live/hybrid profiles)
# Password matches local docker-compose.yml. Server credentials are configured separately.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentic-graphrag

# Qdrant (Settings-backed; live profile)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentic_chunks

# Guardrails and experiment overrides (Settings-backed; .env is supported)
# Values below match configs/default.yaml, rather than the model-only defaults.
# MAX_HOPS=4
# MAX_LLM_CALLS=16
# MAX_TOKENS_PER_QUERY=50000
# AGR_RERANK=none          # none | lexical | http | local; ignored by --no-llm wiring
# AGR_CRITIC_MODE=llm      # llm | tiered | offline; overrides guardrails.critic_mode

# Runtime profiles (process-only; export before startup)
# offline: memory graph/vectors, local indexes and seed graph; default.
# live: Neo4j + Qdrant + shared-file BM25; requested backends must be reachable.
# hybrid: Neo4j + memory vectors + shared-file BM25.
# eval: memory backends + seed graph, caches and local indexes disabled.
# AGR_PROFILE=offline     # offline | live | hybrid | eval
# AGR_ALLOW_LLM=0         # 1 enables the live provider independently of store profile
# AGR_USE_LIVE_STORES=0   # legacy: 1 selects live only when AGR_PROFILE is unset

# Project and runtime paths (process-only)
# Root is auto-detected when unset. Set it before importing application modules.
# AGENTIC_GRAPHRAG_ROOT=/path/to/agentic-graphrag
# Runtime writes: audit chains/events, review queue, ingest tasks and uploads.
# Unset uses paths.processed_dir; relative paths resolve against the project root.
# AGR_RUNTIME_DIR=data/processed

# API server (process-only)
# AGR_API_HOST=0.0.0.0
# AGR_API_PORT=8000
# AGR_API_RELOAD=0

# API authentication and per-tenant rate limits (process-only)
# AGR_REQUIRE_AUTH=0
# Keys are empty by default. Comma-separated tenant:key:role; omitted role = reader.
# Roles: admin | operator | reader. Replace example keys before enabling auth.
# AGR_API_KEYS=default:admin-key:admin,default:operator-key:operator,default:reader-key:reader
# AGR_RATE_LIMIT_QPS=20
# AGR_RATE_LIMIT_CONCURRENT=10
# By default the API key determines user budget identity; 1 trusts X-User-Id.
# AGR_TRUST_X_USER_ID=0

# Inline document ingest worker (process-only; disabled by default)
# 1 starts a worker in the API process, sharing its stores and indexing uploads.
# AGR_INGEST_INLINE=0
# Poll interval in seconds for the inline worker only.
# AGR_INGEST_POLL_SECONDS=2

# JSON logging (process-only)
# AGR_LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR | CRITICAL
# Optional rotating log file; unset logs to stderr only. Relative paths use the cwd.
# AGR_LOG_FILE=logs/agentic-graphrag.log

# PII redaction in logs, traces and persisted reasoning chains (process-only)
# AGR_REDACTION_ENABLED=0
# all, or comma-separated names: email,id_cn,phone_cn,phone_intl.
# AGR_REDACTION_PATTERNS=all

# OpenTelemetry tracing (process-only; API startup; requires the [otel] extra)
# AGR_OTEL_ENABLED=0
# Unset endpoint keeps tracing local; set an OTLP gRPC collector to export spans.
# AGR_OTEL_ENDPOINT=http://localhost:4317
# Fraction of traces sampled, from 0.0 to 1.0.
# AGR_OTEL_SAMPLE_RATE=0.1

# Full application configuration (YAML)
# Parameters without an environment override above must be changed in
# configs/default.yaml. This commented YAML reference is not loaded from .env.
# Values below are the effective defaults without environment overrides.
# name/env are top-level AppConfig fields. Keep credentials in environment variables.
# name: agentic-graphrag
# env: local
# guardrails:
#   requirement_register:
#     enabled: false
#     seed_enabled: true
#     updates_enabled: true
#     delta_enabled: true
#     verifier_enabled: true
#     answer_policy: partial        # partial | abstain
#     seed_top_k: 5                 # >= 1
#     max_rounds: 15                # 1..100
#     context_limit_tokens: 128000  # >= 1
#     convergence_ratio: 0.8        # > 0 and <= 1
#     max_requirements: 32          # 1..100
#   max_hops: 4
#   max_sub_questions: 4           # clamped to max_hops by the runtime guardrails
#   parallel_branches: true
#   max_parallel_branches: 3
#   critic_mode: llm               # llm | tiered | offline
#   max_llm_calls: 16
#   max_tokens_per_query: 50000
#   query_timeout_seconds: 45
#   recursion_limit: 15            # must exceed the graph's required step count
# retrieval:
#   top_k: 10
#   vector_top_k: 10
#   fulltext_top_k: 10
#   fusion_method: rrf             # rrf | concat
#   fusion_k: 60
#   parallel: true
#   cache_answer_ttl_seconds: 3600
#   rerank:
#     kind: none                  # none | lexical | http | local; --no-llm keeps none
#     candidate_pool: 30          # per-channel recall when kind != none
#     top_n: null                 # use retrieval.top_k
#     endpoint: "http://127.0.0.1:8081/rerank"
#     model: "BAAI/bge-reranker-v2-m3"
#     timeout_seconds: 2.0
#     batch_size: 16
#     max_chars: 2000
#     max_query_chars: 1000
#     graph_policy: exempt        # score | exempt | floor
#     graph_floor: 0.0
#     failure_threshold: 2
#     cooldown_seconds: 20.0
#   graph:
#     max_hop_neighbors: 2
#     max_path_hops: 4
#     max_neighbors_per_layer: 50
#     max_paths: 20
#     beam_width: 20
#     high_degree_threshold: 30
#     relation_relevance_threshold: 0.12
# triage:
#   enabled: true
#   escalate_fast_path: true
# knowledge:
#   chunk_size_chars: 1200
#   chunk_overlap_chars: 150
#   extract_confidence_threshold: 0.5
#   schema_path: configs/schema/domain_v0.yaml
#   extract_max_attempts: 3
#   extract_retry_base_delay_seconds: 0.5
#   extract_journal_path: data/processed/extract_journal.jsonl
#   extract_quarantine_path: data/processed/extract_quarantine.jsonl
# llm:
#   strong_model: gpt-4.1
#   light_model: gpt-4.1-mini
#   embedding_model: text-embedding-3-small
#   embedding_base_url: ""
#   embedding_api_key: ""          # use LLM_EMBEDDING_API_KEY for secrets
#   temperature: 0.0
#   max_retries: 2
#   timeout_seconds: 60
#   entailment_check: true         # live claim entailment judge
#   resilience:
#     failure_threshold: 2
#     cooldown_seconds: 20
#     window_seconds: 0            # > 0 enables the failure-rate rule
#     failure_rate: 0.5
#     min_calls: 5
#     fallback_to_light: false
# paths:
#   data_dir: data
#   raw_docs_dir: data/raw
#   processed_dir: data/processed
#   cache_dir: data/cache
#   indexes_dir: data/indexes
#   prompts_dir: configs/prompts
# eval:
#   cases_path: evals/datasets/g2_dev.jsonl
#   report_dir: reports
# tenants: {}
# retention:
#   audit_chains_days: 90
#   audit_events_days: 90
#   review_queue_days: 30
#   ingest_tasks_days: 30

# Per-tenant override example for configs/default.yaml (replace tenants: {} above).
# null leaves a limit unspecified; keys under tenants are your tenant IDs.
# tenants:
#   acme:
#     qps: null
#     concurrent: null
#     max_llm_calls: null
#     max_tokens: null
#     max_cost_units: null

# Optional independent Web application (install .[webapp], run agr-webapp).
# Unlike the core AGR_* switches above, these are read by WebSettings from .env.
# AGR_DATABASE_URL=sqlite:///data/identity/webapp.db
# PostgreSQL: postgresql+psycopg://user:password@localhost/agr_identity
# AGR_WEB_ORIGIN=http://localhost:8000
# AGR_WEB_SECRET=                         # at least 32 random characters; required with Secure cookies
# AGR_WEB_SECRET_FILE=data/identity/signing.key  # local development only; generated with mode 0600
# AGR_WEB_SECURE_COOKIES=false            # true with an HTTPS origin in production
# AGR_WEB_AUTO_MIGRATE=true               # false when migrations run in a deployment job
# AGR_WEB_ACCESS_SECONDS=900
# AGR_WEB_REFRESH_SECONDS=604800
# AGR_WEB_INVITE_SECONDS=604800
# AGR_WEB_AUTH_ATTEMPTS=10
# AGR_WEB_AUTH_WINDOW_SECONDS=300
# AGR_WEB_MAIL_BACKEND=log                # log (development) or smtp
# AGR_WEB_MAIL_FROM=noreply@example.com
# AGR_WEB_SMTP_HOST=
# AGR_WEB_SMTP_PORT=587
# AGR_WEB_SMTP_USER=
# AGR_WEB_SMTP_PASSWORD=
# AGR_DEMO_PASSWORD=                     # seed command only; otherwise prompts without echo
